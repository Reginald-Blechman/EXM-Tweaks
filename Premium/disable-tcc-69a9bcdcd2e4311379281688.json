{
  "_id": "69a9bcdcd2e4311379281688",
  "name": "Disable TCC",
  "description": "Ensure's the GPU runs in standard graphics mode for better compatibility with gaming and desktop workloads.",
  "page": "GPU (nvidia)",
  "category": "Hardware",
  "icon": "system.png",
  "hardwareReqs": [],
  "isMultiOption": false,
  "isPremium": true,
  "options": [],
  "commands": "$gpus=Get-CimInstance Win32_VideoController|Where-Object{$_.PNPDeviceID -like 'PCI\\VEN_10DE*'}; foreach($g in $gpus){ $enum=\"HKLM:\\SYSTEM\\ControlSet001\\Enum\\$($g.PNPDeviceID)\"; $drv=(Get-ItemProperty -Path $enum -Name Driver).Driver; $cls=\"HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Class\\$drv\"; New-ItemProperty -Path $cls -Name 'TCCSupported' -PropertyType DWord -Value 0 -Force; }",
  "revert22H2": "$gpus=Get-CimInstance Win32_VideoController|Where-Object{$_.PNPDeviceID -like 'PCI\\VEN_10DE*'}; foreach($g in $gpus){ $enum=\"HKLM:\\SYSTEM\\ControlSet001\\Enum\\$($g.PNPDeviceID)\"; $drv=(Get-ItemProperty -Path $enum -Name Driver).Driver; $cls=\"HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Class\\$drv\"; New-ItemProperty -Path $cls -Name 'TCCSupported' -PropertyType DWord -Value 1 -Force; }",
