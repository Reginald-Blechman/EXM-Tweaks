{
  "_id": "69a9bcdcd2e431137928168f",
  "name": "Disable NVIDIA Gc5 Caching",
  "description": "Disables GC5 engine caching and power-down behavior to keep GPU engines immediately responsive.",
  "page": "GPU (nvidia)",
  "category": "Hardware",
  "icon": "system.png",
  "hardwareReqs": [],
  "isMultiOption": false,
  "isPremium": true,
  "options": [],
  "commands": "$gpus=Get-CimInstance Win32_VideoController|Where-Object{$_.PNPDeviceID -like 'PCI\\VEN_10DE*'}; foreach($g in $gpus){ $enum=\"HKLM:\\SYSTEM\\ControlSet001\\Enum\\$($g.PNPDeviceID)\"; $drv=(Get-ItemProperty -Path $enum -Name Driver).Driver; $cls=\"HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Class\\$drv\"; New-ItemProperty -Path $cls -Name 'RMDidleFeatureGC5' -PropertyType DWord -Value 44731050 -Force; New-ItemProperty -Path $cls -Name 'RmLpwrCacheStatsOnD3' -PropertyType DWord -Value 0 -Force; }",
  "revert22H2": "$gpus=Get-CimInstance Win32_VideoController|Where-Object{$_.PNPDeviceID -like 'PCI\\VEN_10DE*'}; foreach($g in $gpus){ $enum=\"HKLM:\\SYSTEM\\ControlSet001\\Enum\\$($g.PNPDeviceID)\"; $drv=(Get-ItemProperty -Path $enum -Name Driver).Driver; $cls=\"HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Class\\$drv\"; Remove-ItemProperty -Path $cls -Name 'RMDidleFeatureGC5'; Remove-ItemProperty -Path $cls -Name 'RmLpwrCacheStatsOnD3'; }",
  "revert23H2": "$gpus=Get-CimInstance Win32_VideoController|Where-Object{$_.PNPDeviceID -like 'PCI\\VEN_10DE*'}; foreach($g in $gpus){ $enum=\"HKLM:\\SYSTEM\\ControlSet001\\Enum\\$($g.PNPDeviceID)\"; $drv=(Get-ItemProperty -Path $enum -Name Driver).Driver; $cls=\"HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Class\\$drv\"; Remove-ItemProperty -Path $cls -Name 'RMDidleFeatureGC5'; Remove-ItemProperty -Path $cls -Name 'RmLpwrCacheStatsOnD3'; }",
